function f(x)
    if (x == 0)
        return 0
    end
    return f(x ÷ 10) + 1
end    

function ID_check(x)
    result = 0
    for i in x
        for j in i
            if (f(j) % 2 == 0)
                e = f(j) ÷ 2
                if (j ÷ (10^e) == j % (10^e))
                    result += j
                end   
            end    
        end    
    end
    return result    
end

function read_input(str::String)
    s = split(str, ',')
    arr = []
    for i in s
        x = split(i, '-')
        r = parse(Int64, x[1]) : parse(Int64, x[2])
        push!(arr, r)
    end
    return arr    
end

