function divisors(x)
    res = []
    for i in 1:(x ÷ 2)
        if x % i == 0 
            push!(res, i)
            i += 1
        end    
    end
    return res    
end    

function len_num(x)
    i = 0
    while x > 0
        x = x ÷ 10
        i += 1
    end  
    return i  
end    

function ptn(x, n)
    y = x % 10^n
    while x > 0 && y == x % 10^n
        x = x ÷ 10^n
    end
    if x > 0
        return false    
    else
        return true
    end    
end    

function ID_check2(x)
    result = 0
    for i in x
        for j in i
            for k in divisors(len_num(j))
                if ptn(j, k)
                    result += j
                    break
                end    
            end    
        end    
    end        
    return result        
end


