function max_joltage2(x)
    idx = max_char(x[1:end - 11])
    arr = [x[idx]]
    for i in 1:11
        idx = max_char(x[idx + 1:end - (11 - i)]) + idx
        push!(arr, x[idx])
    end
    s = join(arr)
    return parse(Int64, s)    
end    

function total_joltage2(x)
    res = 0
    for i in x
        res += max_joltage2(i)
    end
    return res    
end    

