input = readlines("Input3.txt")

function max_char(x)
    max = parse(Int64, x[1])
    st = 1
    for i in eachindex(x)
        if parse(Int64, x[i]) > max
            max = parse(Int64, x[i])
            st = i
        end        
    end
    return st    
end

function max_joltage(x)
    st_idx = max_char(x[1:end - 1])
    sc_idx = max_char(x[(st_idx + 1):end]) + st_idx
    return parse(Int64, x[st_idx] * x[sc_idx])    
end    

function total_joltage(x)
    res = 0
    for i in x
        res += max_joltage(i)
    end
    return res    
end    

total_joltage(input)

